Media Ocioso Filtrado =
// AVERAGEX: filtra as linhas de ocioso e tira a média da coluna no final
AVERAGEX (
    FILTER (
        'Motor Ocioso novo',

        // Guarda os dados da linha de ocioso que está sendo testada
        VAR Veic = 'Motor Ocioso novo'[Veiculo]           // veículo do ocioso
        VAR Ent  = 'Motor Ocioso novo'[data entrada]      // início do ocioso
        VAR Sai  = 'Motor Ocioso novo'[data de saida]     // fim do ocioso

        // TESTE 1: janela de horário
        // (ou seja, a hora do dia: ex. 06:30 vira 0,2708)
        VAR NaJanela =
            ( Ent - INT ( Ent ) ) >= TIME ( 6, 0, 0 )     // entrada a partir das 06:00
                && ( Sai - INT ( Sai ) ) <= TIME ( 18, 0, 0 )  // saída até as 18:00
                // && INT ( Ent ) = INT ( Sai )           // descomente para exigir mesmo dia

        // TESTE 2: o ocioso está dentro de um Carregamento Pedreira do mesmo veículo
        VAR NaAtividade =
            COUNTROWS (
                FILTER (
                    'Usina Controle',
                    'Usina Controle'[Veiculo] = Veic                          // mesmo veículo
                        && 'Usina Controle'[ATIVIDADE] = "Carregamento Pedreira"  // atividade certa
                        && 'Usina Controle'[data saída] <= Ent                // trabalho começou antes do ocioso
                        && 'Usina Controle'[retorno] >= Sai                   // trabalho terminou depois do ocioso
                )
            ) > 0   // verdadeiro se existe ao menos uma linha assim

        // TESTE 3: o ocioso está dentro de um ciclo de viagem do mesmo veículo
        VAR NoCiclo =
            COUNTROWS (
                FILTER (
                    'Controle Materiais',
                    'Controle Materiais'[Veiculo] = Veic                      // mesmo veículo
                        && NOT ISBLANK ( 'Controle Materiais'[Inicio Ciclo] ) // ignora 1º ciclo do dia
                        && 'Controle Materiais'[Inicio Ciclo] <= Ent          // ciclo começou antes do ocioso
                        && 'Controle Materiais'[HORA FINAL] >= Sai            // ciclo terminou depois do ocioso
                )
            ) > 0

        RETURN
            // A linha só entra na média se passar nos três testes
            NaJanela && NaAtividade && NoCiclo
    ),
    // Coluna que será mediada, só das linhas aprovadas
    'Motor Ocioso novo'[tempo parado decimal]
)
